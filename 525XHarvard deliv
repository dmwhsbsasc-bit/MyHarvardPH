library(genefilter)
library(qvalue)

set.seed(1)
B <- 1000
n <- 24
m <- 8793
delta <- 1
positives <- 500

# Empty vectors to store our error rates for each run
fpr_bonf <- numeric(B)
fnr_bonf <- numeric(B)
fnr_bh   <- numeric(B)
fnr_q    <- numeric(B)

for(i in 1:B) {
  # 1. Generate random noise and add the true biological signal
  mat <- matrix(rnorm(n*m), m, n)
  mat[1:positives, 1:(n/2)] <- mat[1:positives, 1:(n/2)] + delta
  
  # 2. Run high-throughput t-tests
  g <- factor(rep(c(0, 1), each = n/2))
  pvals <- rowttests(mat, g)$p.value
  
  # 3. Apply the three correction cutoffs
  calls_bonf <- pvals < (0.05 / m)
  calls_bh   <- p.adjust(pvals, method = "BH") < 0.05
  calls_q    <- qvalue(pvals)$qvalues < 0.05
  
  # 4. Calculate Rates for this run
  # False Positive Rate = False Positives / Total True Nulls (8293)
  fpr_bonf[i] <- sum(calls_bonf[501:m]) / (m - positives)
  
  # False Negative Rate = False Negatives / Total True Positives (500)
  fnr_bonf[i] <- sum(!calls_bonf[1:positives]) / positives
  fnr_bh[i]   <- sum(!calls_bh[1:positives]) / positives
  fnr_q[i]    <- sum(!calls_q[1:positives]) / positives
}

# Print the final averaged rates
cat("Bonferroni FPR:", mean(fpr_bonf), "\n")
cat("Bonferroni FNR:", mean(fnr_bonf), "\n")
cat("p.adjust (BH) FNR:", mean(fnr_bh), "\n")
cat("qvalue FNR:", mean(fnr_q), "\n")






